# Application Environment (development | production)
NODE_ENV=development
PORT=3000

# Server Secret for JWT Signing (unique random value of at least 32 UTF-8 bytes in production)
JWT_SECRET=

# Trust exactly one client-IP header only when a controlled reverse proxy overwrites it.
TRUST_PROXY=false
TRUST_PROXY_HEADER=x-forwarded-for

# Local development database. Production MUST replace this with a PostgreSQL URI.
DATABASE_URL="file:./dev.db"

# Production example (store the real password in a secret manager):
# DATABASE_URL="postgresql://app_user:<password>@db.example.internal:5432/carpet_crm?schema=public&sslmode=require"
# For a managed pooler, runtime uses DATABASE_URL while migrations/admin tooling use a direct URL.
# DIRECT_URL="postgresql://app_user:<password>@direct-db.example.internal:5432/carpet_crm?schema=public&sslmode=require"

# Set only during the one-time SQLite -> PostgreSQL transfer.
# Relative file paths are resolved from prisma/sqlite-source (use ../dev.db for prisma/dev.db).
SQLITE_DATABASE_URL=

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Required only during authorized local/disposable seeding.
# Set a unique 12+ character development-only password in your local .env.
SEED_DEFAULT_PASSWORD=

# Production seeding is forbidden; ALLOW_PRODUCTION_SEED is no longer an override.
# PostgreSQL disposable seed requires both dedicated opt-ins plus an independent
# database marker/token. Set them only in an authorized test shell, not here.
# See docs/postgresql-migration.md for POSTGRES_TEST_DATABASE_URL and marker setup.
