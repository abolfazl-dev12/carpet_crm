# Application Environment (development | production)
NODE_ENV=development
PORT=3000

# Server Secret for JWT Signing (Must be a secure random 32+ character string in production)
JWT_SECRET=

# Database Connection (SQLite file or PostgreSQL connection URI)
DATABASE_URL="file:./dev.db"

# Public Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional Seed configuration for development
# SEED_DEFAULT_PASSWORD=
# ALLOW_PRODUCTION_SEED=false
