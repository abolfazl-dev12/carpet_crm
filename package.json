{
  "name": "persian-carpet-crm",
  "version": "1.0.0",
  "description": "Production-Grade Persian Web CRM for Carpet Sales (نرم‌افزار جامع مدیریت ارتباط با مشتریان و فروش فرش)",
  "private": true,
  "scripts": {
    "dev": "npm run prisma:generate:sqlite && next dev",
    "build": "npm run prisma:generate:postgresql && next build",
    "build:offline-validation": "node scripts/run-offline-postgresql-build.cjs",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx,.cjs",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "npm run test:seed-safety && npm run test:postgresql-safety && npm run test:database-config && npm run test:migration:sqlite && npm run test:integration",
    "test:seed-safety": "node --test scripts/test-seed-safety.cjs",
    "test:postgresql-safety": "node --test scripts/test-postgresql-safety.cjs",
    "test:database-config": "node --eval \"process.geteuid ??= () => 0; import('tsx').then(() => import('./scripts/test-production-database-config.ts'))\"",
    "test:migration:sqlite": "prisma generate --schema prisma/sqlite-source/schema.prisma && prisma generate --schema prisma/schema.prisma && node scripts/test-populated-sqlite-migration.cjs",
    "test:integration": "node scripts/run-integration-tests.cjs",
    "test:integration:postgresql": "npm run prisma:generate:postgresql && node scripts/run-postgresql-integration-tests.cjs",
    "test:schema:postgresql": "npm run prisma:generate:postgresql && node scripts/test-postgresql-schema.cjs",
    "test:schema:prisma-postgres": "node scripts/run-prisma-postgres-schema-test.cjs",
    "test:data-migration:postgresql": "prisma generate --schema prisma/sqlite-source/schema.prisma && npm run prisma:generate:postgresql && node scripts/test-postgresql-data-migration.cjs",
    "test:behavior:postgresql": "npm run prisma:generate:postgresql && node scripts/run-postgresql-behavior-tests.cjs",
    "prisma:validate": "npm run prisma:validate:sqlite:offline && npm run prisma:validate:postgresql",
    "prisma:validate:sqlite": "prisma validate --schema prisma/schema.prisma",
    "prisma:validate:sqlite:offline": "node scripts/prisma-sqlite.cjs validate",
    "prisma:validate:postgresql": "node scripts/prisma-postgresql.cjs validate",
    "prisma:validate:postgresql:offline": "node scripts/prisma-postgresql.cjs --offline-schema-only validate",
    "validate": "npm run typecheck && npm run lint && npm run prisma:validate",
    "prisma:generate": "npm run prisma:generate:postgresql",
    "prisma:generate:sqlite": "prisma generate --schema prisma/schema.prisma",
    "prisma:generate:postgresql": "node scripts/prisma-postgresql.cjs generate",
    "prisma:generate:postgresql:offline": "node scripts/prisma-postgresql.cjs --offline-schema-only generate",
    "prisma:generate:migration": "prisma generate --schema prisma/sqlite-source/schema.prisma && npm run prisma:generate:postgresql",
    "prisma:migrate:sqlite": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:production": "node scripts/prisma-postgresql-migrate.cjs deploy",
    "prisma:migrate:status:production": "node scripts/prisma-postgresql-migrate.cjs status",
    "prisma:seed:sqlite": "prisma db seed --schema prisma/schema.prisma",
    "db:setup": "npm run prisma:migrate:sqlite",
    "db:migrate:data:check": "prisma generate --schema prisma/sqlite-source/schema.prisma && node scripts/migrate-sqlite-to-postgres.cjs --check",
    "db:migrate:data:apply": "npm run prisma:generate:migration && node scripts/migrate-sqlite-to-postgres.cjs --apply"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.1.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "jalaali-js": "^1.2.7",
    "jose": "^5.9.6",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.1",
    "recharts": "^2.15.0",
    "tailwind-merge": "^2.5.5",
    "xlsx": "^0.18.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.0",
    "eslint-config-next": "15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.1.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
